{
  "name": "Expense Invoice Tool",
  "enabled": true,

  "publicClient": false,
  "serviceAccountsEnabled": true,
  "clientAuthenticatorType": "client-secret",
  "clientId": "ei-tool",
  "secret": "ei-tool",
  
  "protocol": "openid-connect",
  "protocolMappers": [
    {
      "name": "Audience",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "config": {
        "includedClientAudience": "peopleapi",
        "idTokenClaim": "false",
        "accessTokenClaim": "true",
        "userinfoTokenClaim": "false"
      }
    },
    {
      "name": "People API ID",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usermodel-attribute-mapper",
      "consentRequired": false,
      "config": {
        "introspectionTokenClaim": "true",
        "userinfoTokenClaim": "true",
        "userAttribute": "LDAP_ID",
        "idTokenClaim": "true",
        "lightweightClaim": "false",
        "accessTokenClaim": "true",
        "claimName": "sub",
        "jsonTypeLabel": "String"
      }
    }
  ],
  "roles": [
    "admin"
  ],
  "clientRoles": {
    "accounting-api": [
      "admin"
    ],
    "peopleapi": [
      "admin"
    ]
  },
  "redirectUris": [
    "*"
  ]
}
