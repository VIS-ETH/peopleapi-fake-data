{
  "name": "Member UI",
  "enabled": true,
  "publicClient": true,
  "serviceAccountsEnabled": true,
  "clientAuthenticatorType": "client-secret",
  "clientId": "member-ui",
  "secret": "member-ui",
  "protocol": "openid-connect",
  "protocolMappers": [
    {
      "name": "audience-peopleapi",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "config": {
        "includedClientAudience": "peopleapi",
        "idTokenClaim": "false",
        "accessTokenClaim": "true",
        "userinfoTokenClaim": "false"
      }
    },
    {
      "name": "audience-member-api",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "config": {
        "includedClientAudience": "member-api",
        "idTokenClaim": "false",
        "accessTokenClaim": "true",
        "userinfoTokenClaim": "false"
      }
    },
    {
      "name": "People API ID",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usermodel-attribute-mapper",
      "consentRequired": false,
      "config": {
        "introspectionTokenClaim": "true",
        "userinfoTokenClaim": "true",
        "userAttribute": "LDAP_ID",
        "idTokenClaim": "true",
        "lightweightClaim": "false",
        "accessTokenClaim": "true",
        "claimName": "sub",
        "jsonTypeLabel": "String"
      }
    }
  ],
  "webOrigins": [
    "*"
  ],
  "redirectUris": [
    "*"
  ]
}
